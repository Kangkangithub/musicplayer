<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/music_bg"
    android:padding="8dp">

    <!-- 视频标题栏 -->
    <RelativeLayout
        android:id="@+id/rl_video_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/title_bg"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/iv_video_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/img_music" />
        <TextView
            android:id="@+id/tv_video_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="视频播放"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 视频播放区 -->
    <FrameLayout
        android:id="@+id/fl_video_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@id/rl_video_header"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#000000">
        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 装饰分隔线 -->
    <View
        android:id="@+id/v_divider"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_below="@id/fl_video_container"
        android:background="@drawable/btn_bg" />

    <!-- 视频列表区域 -->
    <LinearLayout
        android:id="@+id/ll_video_list_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/v_divider"
        android:orientation="vertical"
        android:background="#AA000000">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="▶ 视频列表"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/lv_video"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#30FFFFFF"
            android:dividerHeight="1dp" />
    </LinearLayout>

</RelativeLayout>
